{
    "clangd.path": "/usr/bin/clangd",
    "clangd.arguments": [
        "--query-driver=/usr/bin/g++"
    ],
    "clangd.fallbackFlags": [
        "-std=c++26"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "kylinideteam.kylin-clangd",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "files.associations": {
        "*.hpp": "cpp"
    }
}
