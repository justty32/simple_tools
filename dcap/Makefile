# Build dcap itself. No CMake — just g++ (C++20) + make + sh. POSIX-oriented.
ifeq ($(origin CXX),default)
  CXX := g++
endif
CXXFLAGS := -std=c++20 -O2 -Wall -Wextra
SRC      := $(wildcard src/*.cpp)
BIN      := bin/dcap
# templates/ files are #embed-ed via the generated lists, so they are build inputs.
TEMPLATE_FILES := $(shell find templates -type f)
# The built-in template registry, generated by scanning templates/ so that
# adding a template — or a file inside one — never means editing C++.
EMBED_INC := build/builtin_tables.inc

all: $(BIN)

$(EMBED_INC): tools/gen-embed.sh $(TEMPLATE_FILES)
	@mkdir -p build
	sh tools/gen-embed.sh > $@

$(BIN): $(SRC) $(EMBED_INC)
	@mkdir -p bin
	$(CXX) $(CXXFLAGS) -Ibuild $(SRC) -o $@

clean:
	rm -rf bin build

# Never leave a half-written generated file behind for the next build to use.
.DELETE_ON_ERROR:
.PHONY: all clean
