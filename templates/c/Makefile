# Auto-generated by dcap - minimal universal Makefile (C11).
# Use gcc unless the user explicitly overrides (env or command line).
ifeq ($(origin CC),default)
  CC := gcc
endif
CFLAGS   := -std=c11 -O2 -Wall -Wextra
# Static-link so the binary runs standalone (no MinGW DLLs on PATH needed).
LDFLAGS  := -static
LDLIBS   := -lm -lpthread
NAME     := @NAME@

ifeq ($(OS),Windows_NT)
  DCAP_HOME ?= C:/dev/dcap
  EXE       := .exe
else
  DCAP_HOME ?= $(HOME)/dev/dcap
  EXE       :=
endif

INCLUDES := -I. -I$(DCAP_HOME)/c_libs
SRC      := $(shell find . -name '*.c')
BIN      := bin/$(NAME)$(EXE)

all: $(BIN)

$(BIN): $(SRC)
	@mkdir -p bin
	$(CC) $(CFLAGS) $(INCLUDES) $(SRC) -o $@ $(LDFLAGS) $(LDLIBS)

run: all
	./$(BIN)

clean:
	rm -rf bin

.PHONY: all run clean
