# Auto-generated by dcap - minimal universal Makefile (C++20).
# Use g++ unless the user explicitly overrides (env or command line).
ifeq ($(origin CXX),default)
  CXX := g++
endif
CXXFLAGS := -std=c++20 -O2 -Wall -Wextra
# Static-link so the binary runs standalone (no MinGW DLLs on PATH needed).
LDFLAGS  := -static
NAME     := @NAME@

ifeq ($(OS),Windows_NT)
  DCAP_HOME ?= C:/dev/dcap
  EXE       := .exe
else
  DCAP_HOME ?= $(HOME)/dev/dcap
  EXE       :=
endif

INCLUDES := -I. -I$(DCAP_HOME)/cpp_libs
SRC      := $(shell find . -name '*.cpp')
BIN      := bin/$(NAME)$(EXE)

all: $(BIN)

$(BIN): $(SRC)
	@mkdir -p bin
	$(CXX) $(CXXFLAGS) $(INCLUDES) $(SRC) -o $@ $(LDFLAGS)

run: all
	./$(BIN)

clean:
	rm -rf bin

.PHONY: all run clean
